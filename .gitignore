# ── Model checkpoints ────────────────────────────────────────
*.pth
*.pt
*.ckpt

# ── Datasets & archives (multi-GB, download separately) ──────
*.zip
*.tgz
*.tar.gz
CUB_200_2011/
birds_split/
# Downloaded media is CC-licensed and re-fetchable from the manifests, but
# bulky. Keep the manifests so attribution and the exact file list survive
# even though the bytes do not.
bird_audio_samples/*
!bird_audio_samples/manifest.json

data/openset/*
!data/openset/manifest.json
!data/openset/threshold.json

# ── Generated output ─────────────────────────────────────────
evaluation/
results.json
.gradio/
server.log
*.pid

# ── Secrets ──────────────────────────────────────────────────
.env
.env.*
!.env.example

# ── Python ───────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/

# ── Node ─────────────────────────────────────────────────────
node_modules/
dist/

# ── macOS ────────────────────────────────────────────────────
.DS_Store

# Intermediate build artifact for the knowledge base; species_kb.json is
# the committed output. Keeps the resumable cache out of history.
data/species_kb.jsonl
